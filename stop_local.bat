@echo off
echo Stopping OpsPilot AI servers...
echo Killing backend on port 8000...
for /f "tokens=5" %%a in ('netstat -aon ^| find ":8000" ^| find "LISTENING"') do taskkill /f /pid %%a 2>nul
echo Killing frontend on port 5173...
for /f "tokens=5" %%a in ('netstat -aon ^| find ":5173" ^| find "LISTENING"') do taskkill /f /pid %%a 2>nul
echo Done. All OpsPilot AI servers stopped.
pause
