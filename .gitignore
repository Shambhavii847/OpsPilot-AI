# ============================================================
# OpsPilot AI — .gitignore
# ============================================================

# ------ Python ------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.cover

# ------ Node / Frontend ------
node_modules/
frontend/dist/
.parcel-cache/
.npm/
*.tsbuildinfo

# ------ Environment & Secrets ------
.env
.env.local
.env.*.local
.env.production
backend/.env
.env.*
!.env.example

# ------ Database ------
*.db
*.sqlite
*.sqlite3
# Keep the data directory itself
!data/.gitkeep

# ------ OS ------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# ------ IDE / Editor ------
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath

# ------ Logs ------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------ Misc ------
*.bak
*.tmp
.cache/
